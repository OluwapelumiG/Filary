{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install",
  "buildCommand": "bun run release",
  "outputDirectory": "web",
  "cleanUrls": true,
  "functions": {
    "api/generate.ts": {
      "maxDuration": 15,
      "includeFiles": "node_modules/@faker-js/**"
    },
    "api/profile.ts": {
      "maxDuration": 10,
      "includeFiles": "node_modules/@faker-js/**"
    }
  },
  "headers": [
    {
      "source": "/filary-extension.zip",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/zip"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"filary-extension.zip\""
        }
      ]
    }
  ]
}
