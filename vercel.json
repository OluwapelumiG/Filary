{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install",
  "buildCommand": "echo 'Static web/ + serverless api/'",
  "outputDirectory": "web",
  "cleanUrls": true,
  "functions": {
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "server/src/**"
    }
  }
}
